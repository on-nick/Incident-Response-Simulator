# Copy this file to .env and fill in values as needed.
# Never commit your real .env file — it's already in .gitignore.

# Optional: enables real AI-generated incident summaries via the Anthropic API.
# If left blank, the app falls back to a rule-based summary automatically —
# nothing breaks without this key.
ANTHROPIC_API_KEY=

# Optional: override detection thresholds (all have sensible defaults).
# THRESHOLD_PORT_SCAN_PORTS=5
# THRESHOLD_SYN_FLOOD_EVENTS=10
# THRESHOLD_BRUTE_FORCE_ATTEMPTS=5
# THRESHOLD_MALWARE_BEACON_COUNT=3

# Optional: rate limit for POST /api/simulate and /api/simulate/stream
# RATE_LIMIT_SIMULATE=20 per minute

# Optional: where the SQLite database file is stored
# DATABASE_PATH=data/incidents.db
